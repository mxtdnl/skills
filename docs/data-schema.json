{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skills5c-data-schema-v4",
  "title": "5C Skills Assessment data model",
  "description": "Records stored under skills5c:v4:* and in JSON exports. Generated from src/core/schema.js; do not edit by hand. Cross-field rules are listed in docs/DATA-SCHEMA.md.",
  "$defs": {
    "participant": {
      "description": "One student, identified only by a random pseudonymous code.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "participant"
        },
        "schemaVersion": {
          "type": "integer",
          "minimum": 1
        },
        "id": {
          "type": "string",
          "pattern": "^P-[0-9A-HJKMNP-TV-Z]{4}-[0-9A-HJKMNP-TV-Z]{5}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "consent": {
          "type": "object",
          "properties": {
            "noticeVersion": {
              "type": "string"
            },
            "givenAt": {
              "type": "string",
              "format": "date-time"
            },
            "toolUse": {
              "type": "boolean",
              "const": true
            },
            "programmeEvaluation": {
              "type": "boolean"
            },
            "languageBackground": {
              "type": "boolean"
            }
          },
          "required": [
            "noticeVersion",
            "givenAt",
            "toolUse",
            "programmeEvaluation",
            "languageBackground"
          ],
          "additionalProperties": false
        },
        "languageBackground": {
          "type": "object",
          "properties": {
            "englishFirstLanguage": {
              "type": "string",
              "enum": [
                "yes",
                "no",
                "prefer-not-to-say"
              ]
            }
          },
          "required": [
            "englishFirstLanguage"
          ],
          "additionalProperties": false
        },
        "settings": {
          "type": "object",
          "properties": {
            "timeMultiplier": {
              "type": "number",
              "enum": [
                1,
                1.5,
                2
              ]
            },
            "reducedMotion": {
              "type": "boolean"
            }
          },
          "required": [
            "timeMultiplier",
            "reducedMotion"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "schemaVersion",
        "id",
        "createdAt",
        "consent"
      ],
      "additionalProperties": false
    },
    "sitting": {
      "description": "One occasion on which a participant works through one skill's steps in one mode with one form.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "sitting"
        },
        "schemaVersion": {
          "type": "integer",
          "minimum": 1
        },
        "id": {
          "type": "string",
          "pattern": "^S-[0-9A-HJKMNP-TV-Z]{16}$"
        },
        "participantId": {
          "type": "string",
          "pattern": "^P-[0-9A-HJKMNP-TV-Z]{4}-[0-9A-HJKMNP-TV-Z]{5}$"
        },
        "skillId": {
          "type": "string",
          "pattern": "^[a-z0-9_][a-z0-9_-]*$"
        },
        "mode": {
          "type": "string",
          "enum": [
            "practice",
            "assessment"
          ]
        },
        "windowId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(self|programme:[A-Z0-9]{2,12}-[1-9])$"
        },
        "programme": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[A-Z0-9]{2,12}-[1-9]$"
            },
            "window": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9
            },
            "skillOrder": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9_][a-z0-9_-]*$"
              }
            },
            "position": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "code",
            "window",
            "skillOrder",
            "position"
          ],
          "additionalProperties": false
        },
        "formId": {
          "type": "string",
          "pattern": "^(A|B|practice)$"
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "appVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
        },
        "scoringVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "completedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "type",
        "schemaVersion",
        "id",
        "participantId",
        "skillId",
        "mode",
        "windowId",
        "programme",
        "formId",
        "seed",
        "appVersion",
        "scoringVersion",
        "startedAt",
        "completedAt"
      ],
      "additionalProperties": false
    },
    "taskAttempt": {
      "description": "One attempt at one task within a sitting, with every raw response and its timing.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "taskAttempt"
        },
        "schemaVersion": {
          "type": "integer",
          "minimum": 1
        },
        "id": {
          "type": "string",
          "pattern": "^A-[0-9A-HJKMNP-TV-Z]{16}$"
        },
        "sittingId": {
          "type": "string",
          "pattern": "^S-[0-9A-HJKMNP-TV-Z]{16}$"
        },
        "skillId": {
          "type": "string",
          "pattern": "^[a-z0-9_][a-z0-9_-]*$"
        },
        "taskId": {
          "type": "string",
          "pattern": "^[a-z0-9_][a-z0-9_-]*$"
        },
        "itemResponses": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "itemId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+$"
              },
              "response": {
                "description": "Raw response; any JSON value. Its shape is defined by the task."
              },
              "rtMs": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "shownAt": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "itemId",
              "response",
              "rtMs",
              "shownAt"
            ],
            "additionalProperties": false
          }
        },
        "rawScore": {
          "type": [
            "number",
            "null"
          ]
        },
        "score": {
          "type": [
            "number",
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "scoringVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
        },
        "status": {
          "type": "string",
          "enum": [
            "in-progress",
            "complete"
          ]
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "completedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "timerSnapshot": {
          "description": "State of the task timer while the attempt is in progress (src/core/timing.js snapshot()).",
          "type": "object",
          "properties": {
            "limitMs": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "multiplier": {
              "type": "number",
              "minimum": 1
            },
            "state": {
              "type": "string",
              "enum": [
                "idle",
                "running",
                "paused",
                "expired",
                "stopped"
              ]
            },
            "endAt": {
              "type": [
                "number",
                "null"
              ]
            },
            "remainingMs": {
              "type": [
                "number",
                "null"
              ]
            },
            "extendedMs": {
              "type": "number",
              "minimum": 0
            },
            "pausedMs": {
              "type": "number",
              "minimum": 0
            },
            "pausedAt": {
              "type": [
                "number",
                "null"
              ]
            },
            "startedAt": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "limitMs",
            "multiplier",
            "state",
            "endAt",
            "remainingMs",
            "extendedMs",
            "pausedMs",
            "pausedAt",
            "startedAt"
          ],
          "additionalProperties": false
        },
        "coachScorable": {
          "description": "Set on completion of a task that has no automated score (CM-T3 Rewrite): true when the attempt holds a finished response for a coach to score. Added in schema version 4.",
          "type": "boolean"
        },
        "timing": {
          "type": "object",
          "properties": {
            "limitMs": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "multiplier": {
              "type": "number",
              "minimum": 1
            },
            "extendedMs": {
              "type": "number",
              "minimum": 0
            },
            "pausedMs": {
              "type": "number",
              "minimum": 0
            },
            "expired": {
              "type": "boolean"
            }
          },
          "required": [
            "limitMs",
            "multiplier",
            "extendedMs",
            "pausedMs",
            "expired"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "schemaVersion",
        "id",
        "sittingId",
        "skillId",
        "taskId",
        "itemResponses",
        "rawScore",
        "score",
        "scoringVersion",
        "status",
        "startedAt",
        "updatedAt",
        "completedAt"
      ],
      "additionalProperties": false
    },
    "selfReport": {
      "description": "One skill's self-report questionnaire within a sitting.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "selfReport"
        },
        "schemaVersion": {
          "type": "integer",
          "minimum": 1
        },
        "id": {
          "type": "string",
          "pattern": "^R-[0-9A-HJKMNP-TV-Z]{16}$"
        },
        "sittingId": {
          "type": "string",
          "pattern": "^S-[0-9A-HJKMNP-TV-Z]{16}$"
        },
        "skillId": {
          "type": "string",
          "pattern": "^[a-z0-9_][a-z0-9_-]*$"
        },
        "responses": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "itemId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+$"
              },
              "response": {
                "description": "Raw response; any JSON value. Its shape is defined by the task."
              },
              "rtMs": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "shownAt": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "itemId",
              "response",
              "rtMs",
              "shownAt"
            ],
            "additionalProperties": false
          }
        },
        "score": {
          "type": [
            "number",
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "retrospective": {
          "description": "End-of-programme retrospective (\"then\") rating per facet, 1 to 5; never part of the skill score. Added in schema version 3.",
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "quality": {
          "description": "Response-quality indicators for the coach view. Never shown to the student and never used in a score. Added in schema version 3.",
          "type": "object",
          "properties": {
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "answered": {
              "type": "integer",
              "minimum": 0
            },
            "missing": {
              "type": "integer",
              "minimum": 0
            },
            "straightLining": {
              "type": "boolean"
            },
            "medianItemMs": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "fastResponding": {
              "type": "boolean"
            },
            "longestRun": {
              "type": "integer",
              "minimum": 0
            },
            "longRun": {
              "type": "boolean"
            }
          },
          "required": [
            "items",
            "answered",
            "missing",
            "straightLining",
            "medianItemMs",
            "fastResponding",
            "longestRun",
            "longRun"
          ],
          "additionalProperties": false
        },
        "scoringVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
        },
        "status": {
          "type": "string",
          "enum": [
            "in-progress",
            "complete"
          ]
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "completedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "type",
        "schemaVersion",
        "id",
        "sittingId",
        "skillId",
        "responses",
        "score",
        "scoringVersion",
        "status",
        "startedAt",
        "updatedAt",
        "completedAt"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/participant"
    },
    {
      "$ref": "#/$defs/sitting"
    },
    {
      "$ref": "#/$defs/taskAttempt"
    },
    {
      "$ref": "#/$defs/selfReport"
    }
  ]
}
